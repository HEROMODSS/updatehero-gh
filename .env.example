# Set these in Vercel → Project → Settings → Environment Variables.

# Password you type on the login screen.
ADMIN_PASSWORD=choose-a-strong-password

# Recommended: long random string used to sign sessions (falls back to a key derived from password + token).
SESSION_SECRET=any-long-random-string

# GitHub token. Fine-grained (recommended): Contents = Read and write, Administration = Read and write
# (only needed to create apps here), limited to your repos. A classic token with the "repo" scope also works.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub username (or organization).
GITHUB_OWNER=HEROMODSS
# Only if GITHUB_OWNER is an organization:
# GITHUB_OWNER_IS_ORG=1

# Optional: makes the login lock survive server restarts (free Upstash Redis).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
